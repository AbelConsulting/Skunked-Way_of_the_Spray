<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. NoActionBar + dark background so the activity
         never paints a white title bar / action bar behind the WebView. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/appBackground</item>
        <item name="android:colorBackground">@color/appBackground</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/appBackground</item>
        <item name="android:colorBackground">@color/appBackground</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Dark window background so the splash.png icon + any safe-area
             gaps never flash white behind the WebView. On Android 12+,
             installSplashScreen() in MainActivity triggers the postSplashScreenTheme
             transition; this color is also the fallback for pre-12 devices. -->
        <item name="android:windowBackground">@color/appBackground</item>
        <item name="android:background">@color/appBackground</item>
        <!-- Splash-screen icon (small, centered on the splash background). -->
        <item name="windowSplashScreenBackground">@color/appBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <!-- After the splash hides, swap to the no-action-bar dark theme so
             the WebView is never framed by AppCompat's white title bar. -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>