// ─────────────────────────────────────────────────────────────────────────────
// SteamPipe Depot Build Script — Windows depot (4815181) for AppID 4815180
//
// FileMapping "*" with recursive "1" uploads the entire contentroot
// (release/win-unpacked) into the depot. Adjust DepotID if Steamworks assigned
// a different Windows depot on the SteamPipe tab.
// ─────────────────────────────────────────────────────────────────────────────
"DepotBuildConfig"
{
	"DepotID"	"4815181"

	// Overrides the appbuild-level "contentroot" so this depot can be combined
	// with the mac/Linux depots in a single multi-platform build (see
	// app_build_4815180_all.vdf).
	"ContentRoot"	"..\\release\\win-unpacked\\"

	"FileMapping"
	{
		"LocalPath"	"*"
		"DepotPath"	"."
		"recursive"	"1"
	}

	// Strip debug symbols, build cruft, and local Steam auth files that
	// should never be shipped inside a depot.
	"FileExclusion"	"*.pdb"
	"FileExclusion"	"*.map"
	"FileExclusion"	"steam_appid.txt"
	"FileExclusion"	"*/steam_appid.txt"
	"FileExclusion"	"*/*/steam_appid.txt"
	"FileExclusion"	"*/*/*/steam_appid.txt"
}
