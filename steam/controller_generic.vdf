// ─────────────────────────────────────────────────────────────────────────────
// Steam Input Default Configuration — Generic Gamepad (Xbox / third-party)
// Skunked: Way of the Spray  (AppID 4815180)
//
// Binding strategy: XInput emulation.
//   The game reads the Web Gamepad API (mapping='standard').  Steam Input
//   passes physical buttons through as virtual XInput, which the game reads
//   via navigator.getGamepads().  No game-code changes needed.
//
// How to upload:
//   1. Steamworks partner portal → App Admin → Community → Controller Configs
//   2. Add new config → upload this file → set controller type = Generic Gamepad
//   3. Repeat with controller_steamdeck.vdf for Steam Deck
//   4. Publish Steamworks changes
//
// Button layout:
//   A          = Jump
//   B          = Shadow Strike (special attack)
//   X          = Attack
//   Y          = Shadow Strike (alternate)
//   LT         = Skunk Shot (spray)
//   RT         = Attack (alternate)
//   LB         = Pause
//   RB         = Skunk Shot (alternate)
//   D-pad ←/→  = Move Left / Move Right
//   D-pad ↑    = Jump (alternate)
//   Left Stick = Move Left / Move Right
//   Start      = Pause
//   Select     = Confirm / Restart
// ─────────────────────────────────────────────────────────────────────────────
"controller_mappings"
{
	"version"		"3"
	"revision"		"1"
	"title"		"Skunked: Way of the Spray — Default Gamepad"
	"description"		"A=Jump · X=Attack · B/Y=Shadow Strike · LT/RB=Skunk Shot · RT=Attack · LB/Start=Pause"
	"creator"		"0"
	"progenitor"		""
	"URL"		""
	"export_type"		"template"
	"controller_type"		"controller_generic"
	"controller_caps"		"8323135"
	"major_revision"		"0"
	"minor_revision"		"0"
	"steam_input_enabled"		"1"
	"Metadata"
	{
		"input_source"		"gamepad"
	}

