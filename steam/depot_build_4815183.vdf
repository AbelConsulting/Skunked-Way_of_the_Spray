// ─────────────────────────────────────────────────────────────────────────────
// SteamPipe Depot Build Script — Linux depot (4815183) for AppID 4815180
//
// electron-builder's AppImage target is a single-file bundle, which is awkward
// for SteamPipe. For Steam, prefer the unpacked "linux-unpacked" directory
// (add a "dir" target in package.json build.linux.target, or extract the
// AppImage). This contentroot assumes release/linux-unpacked/.
// ─────────────────────────────────────────────────────────────────────────────
"DepotBuildConfig"
{
	"DepotID"	"4815183"

	// Overrides the appbuild-level "contentroot" so this depot can be combined
	// with the Windows/mac depots in a single multi-platform build (see
	// app_build_4815180_all.vdf).
	"ContentRoot"	"../release/linux-unpacked/"

	"FileMapping"
	{
		"LocalPath"	"*"
		"DepotPath"	"."
		"recursive"	"1"
	}

	// Strip debug symbols, build cruft, and local Steam auth files that
	// should never be shipped inside a depot.
	"FileExclusion"	"*.pdb"
	"FileExclusion"	"*.map"
	"FileExclusion"	"steam_appid.txt"
	"FileExclusion"	"*/steam_appid.txt"
	"FileExclusion"	"*/*/steam_appid.txt"
	"FileExclusion"	"*/*/*/steam_appid.txt"
}
