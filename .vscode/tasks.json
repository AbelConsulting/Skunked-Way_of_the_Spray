{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run SkunkFU Game (JS)",
			"type": "shell",
			"command": "python",
			"args": ["-m", "http.server", "8000"],
			"isBackground": true,
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Open JS Game in Browser",
			"type": "shell",
			"command": "start",
			"args": ["http://localhost:8000"],
			"windows": {
				"command": "cmd",
				"args": ["/c", "start", "http://localhost:8000"]
			}
		},
		{
			"label": "Sprite Smoke Test",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"toolshed/test_sprites.py"
			],
			"group": {
				"kind": "test",
				"isDefault": true
			}
		},
		{
			"label": "Convert Quadrants to Horizontal",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": ["convert_quadrants_to_horizontal.py"]
		},
		{
			"label": "Remove Sprite Backgrounds",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": ["remove_sprite_backgrounds.py"]
		},
		{
			"label": "Cleanup Sprites",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": ["cleanup_sprites.py"]
		},
		{
			"label": "Generate Metal Sound",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": ["generate_metal_sound.py"]
		},
		{
			"label": "Generate Metal Guitar",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": ["generate_metal_sound.py"]
		},
		{
			"label": "Analyze Music Mix",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": ["analyze_music_mix.py"]
		},
		{
			"label": "Generate Background Music",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": ["generate_music.py"]
		},
		{
			"label": "Capacitor: Build & Copy",
			"type": "shell",
			"command": "npm",
			"args": ["run", "cap:build"],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Capacitor: Sync Android",
			"type": "shell",
			"command": "npm",
			"args": ["run", "cap:sync"],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Capacitor: Open Android Studio",
			"type": "shell",
			"command": "npx",
			"args": ["cap", "open", "android"],
			"problemMatcher": []
		},
		{
			"label": "Firebase: Start Emulators",
			"type": "shell",
			"command": "npm",
			"args": ["run", "firebase:emulators"],
			"isBackground": true,
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "Firebase: Local Serve (build + serve)",
			"type": "shell",
			"command": "npm",
			"args": ["run", "firebase:serve"],
			"isBackground": true,
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "Firebase: Deploy All",
			"type": "shell",
			"command": "npm",
			"args": ["run", "firebase:deploy"],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Firebase: Deploy Hosting Only",
			"type": "shell",
			"command": "npm",
			"args": ["run", "firebase:deploy:hosting"],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Firebase: Deploy Functions Only",
			"type": "shell",
			"command": "npm",
			"args": ["run", "firebase:deploy:functions"],
			"problemMatcher": []
		},
		{
			"label": "Firebase: Deploy Firestore Rules",
			"type": "shell",
			"command": "npm",
			"args": ["run", "firebase:deploy:rules"],
			"problemMatcher": []
		},
		{
			"label": "Firebase: View Logs",
			"type": "shell",
			"command": "firebase",
			"args": ["functions:log", "--only", "submitScore,getLeaderboard,health"],
			"problemMatcher": []
		},
		{
			"label": "Firebase: Open Console in Browser",
			"type": "shell",
			"command": "cmd",
			"args": ["/c", "start", "https://studio.firebase.google.com/wots-52349111"],
			"windows": {
				"command": "cmd",
				"args": ["/c", "start", "https://studio.firebase.google.com/wots-52349111"]
			},
			"problemMatcher": []
		}
	]
}