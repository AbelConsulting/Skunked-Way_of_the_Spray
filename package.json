{
  "name": "skunkfu",
  "version": "1.3.11",
  "description": "Skunked: Way of the Spray — a fast-paced ninja skunk action platformer.",
  "author": "Mephitideus Interactive LLC",
  "main": "index.js",
  "private": true,
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "capacitor:sync:before": "patch-package --error-on-fail",
    "test:purchases": "node --test tools/purchase_manager_test.js",
    "test:purchase-ui": "node tools/purchase_ui_test.js",
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "start": "node tools/csp_server.js",
    "serve:py": "python -m http.server 8000",
    "check:sprite-frames": "python toolshed/check_sprite_frames.py",
    "fix:sprites": "python toolshed/fix_spritesheets.py --backup --verbose",
    "extract:ninja-walk": "python toolshed/extract_ninja_walk_frames.py",
    "preview:sprites": "python toolshed/preview_sprites.py",
    "test:touch-landscape": "node tools/touch_controls_landscape_test.js",
    "test:portrait-rotate": "node tools/portrait_start_rotate_test.js",
    "test:touch-present": "node tools/touch_controls_present_on_start_test.js",
    "test:touch-immediate": "node tools/touch_controls_immediate_test.js",
    "test:mobile-perf": "node tools/mobile_performance_test.js",
    "test:mobile-probe": "node tools/mobile_probe_test.js",
    "test:mobile-diagnostics": "node tools/mobile_diagnostics.js",
    "test:mobile-diagnostics-landscape": "node tools/mobile_diagnostics_landscape.js",
    "test:mobile-all": "npm run test:touch-landscape && npm run test:portrait-rotate && npm run test:touch-present && npm run test:touch-immediate && npm run test:mobile-perf && npm run test:mobile-probe",
    "test:sprite-padding": "node tools/check_sprite_padding.js",
    "test:steam-home": "node tools/steam_home_screen_test.js",
    "playwright:install": "npx playwright install",
    "deploy:wrangler": "node -e \"console.error('Error: This is a Cloudflare Pages project. Use: npm run deploy:pages'); process.exit(1)\"",
    "deploy:pages": "npm run build && npx wrangler pages deploy ./dist",
    "firebase:emulators": "firebase emulators:start",
    "firebase:serve": "npm run build && firebase serve",
    "firebase:deploy": "npm run build && firebase deploy",
    "firebase:deploy:hosting": "npm run build && firebase deploy --only hosting",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "cap:build": "npm run build && npx cap copy android",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "android:check-upload-key": "node tools/check_upload_key_fingerprint.js",
    "android:bundle:release": "npm run cap:sync && npm run android:check-upload-key && cd android && gradlew.bat bundleRelease",
    "electron:dev": "node scripts/build-steam.js && npx electron electron/main.js",
    "electron:build": "node scripts/build-steam.js --release && npx electron-builder --config",
    "electron:build:win": "node scripts/build-steam.js --release && npx electron-builder --win --config",
    "electron:build:mac": "node scripts/build-steam.js --release && npx electron-builder --mac --config",
    "electron:build:linux": "node scripts/build-steam.js --release && npx electron-builder --linux dir --config",
    "electron:build:linux:appimage": "node scripts/build-steam.js --release && npx electron-builder --linux AppImage --config",
    "steam:build": "node scripts/build-steam.js --release",
    "steam:assets": "python generate_steam_assets.py",
    "steam:release:win": "steam\\release-win.bat",
    "steam:upload:linux": "steam\\upload-linux.bat",
    "steam:upload:all": "steam\\upload-all.bat",
    "steam:demo:build": "node scripts/build-steam-demo.js --release",
    "electron:demo:dev": "node scripts/build-steam-demo.js && npx electron electron/main-demo.js",
    "electron:demo:build:win": "node scripts/build-steam-demo.js --release && npx electron-builder --win --config electron-builder-demo.json"
  },
  "build": {
    "appId": "com.mephitideusinteractive.skunkedwayofthespray",
    "productName": "Skunked: Way of the Spray",
    "copyright": "Copyright © 2026 Mephitideus Interactive LLC",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "dist-steam/**/*",
      "electron/**/*",
      "assets/icons/**/*",
      "!node_modules/@aws-sdk/**",
      "!node_modules/@smithy/**",
      "!node_modules/@aws-crypto/**",
      "!node_modules/@capacitor/**",
      "!node_modules/@capacitor-community/**",
      "!node_modules/cordova-plugin-purchase/**",
      "!node_modules/esbuild/**",
      "!node_modules/@esbuild/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon-512x512.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/icon-512x512.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon-512x512.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.90.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "cordova-plugin-purchase": "13.15.4",
    "steamworks.js": "^0.4.0"
  },
  "optionalDependencies": {
    "@electron/windows-sign": "^1.2.2",
    "@esbuild/win32-x64": "^0.28.0"
  }
}
