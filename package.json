{
  "name": "skunkfu",
  "version": "1.0.9",
  "main": "index.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "start": "node tools/csp_server.js",
    "serve:py": "python -m http.server 8000",
    "check:sprite-frames": "python toolshed/check_sprite_frames.py",
    "fix:sprites": "python toolshed/fix_spritesheets.py --backup --verbose",
    "extract:ninja-walk": "python toolshed/extract_ninja_walk_frames.py",
    "preview:sprites": "python toolshed/preview_sprites.py",
    "test:touch-landscape": "node tools/touch_controls_landscape_test.js",
    "test:portrait-rotate": "node tools/portrait_start_rotate_test.js",
    "test:touch-present": "node tools/touch_controls_present_on_start_test.js",
    "test:touch-immediate": "node tools/touch_controls_immediate_test.js",
    "test:mobile-perf": "node tools/mobile_performance_test.js",
    "test:mobile-probe": "node tools/mobile_probe_test.js",
    "test:mobile-diagnostics": "node tools/mobile_diagnostics.js",
    "test:mobile-diagnostics-landscape": "node tools/mobile_diagnostics_landscape.js",
    "test:mobile-all": "npm run test:touch-landscape && npm run test:portrait-rotate && npm run test:touch-present && npm run test:touch-immediate && npm run test:mobile-perf && npm run test:mobile-probe",
    "test:sprite-padding": "node tools/check_sprite_padding.js",
    "playwright:install": "npx playwright install",
    "deploy:wrangler": "node -e \"console.error('Error: This is a Cloudflare Pages project. Use: npm run deploy:pages'); process.exit(1)\"",
    "deploy:pages": "npm run build && npx wrangler pages deploy ./dist",
    "firebase:emulators": "firebase emulators:start",
    "firebase:serve": "npm run build && firebase serve",
    "firebase:deploy": "npm run build && firebase deploy",
    "firebase:deploy:hosting": "npm run build && firebase deploy --only hosting",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "cap:build": "npm run build && npx cap copy android",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "android:check-upload-key": "node tools/check_upload_key_fingerprint.js",
    "android:bundle:release": "npm run cap:sync && npm run android:check-upload-key && cd android && gradlew.bat bundleRelease"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.90.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "cordova-plugin-purchase": "^13.15.4"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.0"
  }
}
